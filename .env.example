# Supabase проекта Food. Значения — Supabase Dashboard → Project Settings → API.
# Ключ anon публикуемый: он предназначен для браузера, доступ ограничивают
# RLS-политики. Но в публичный репозиторий его не кладём — политики пока
# демонстрационные и разрешают анониму править заказы.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
